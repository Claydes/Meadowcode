DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=UTC

POSTGRES_DB=meadowcode_db
POSTGRES_USER=meadowcode
POSTGRES_PASSWORD=meadowcode
POSTGRES_HOST=db
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_TIME_LIMIT=30
CELERY_TASK_ALWAYS_EAGER=false

DRF_PAGE_SIZE=20
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

JUDGE_PYTHON_IMAGE=python:3.12-slim
JUDGE_PULL_IMAGE=false
JUDGE_MIN_TIMEOUT_SECONDS=1
JUDGE_TIMEOUT_GRACE_SECONDS=1
JUDGE_OUTPUT_LIMIT_BYTES=1048576
JUDGE_DOCKER_USER=65534:65534
JUDGE_DOCKER_PIDS_LIMIT=64
JUDGE_DOCKER_NANO_CPUS=1000000000
